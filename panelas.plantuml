@startuml ecommerce
class Panela{
- id : long
- modelo : String
- preco : long
- peso : double
- capacidadeLitros : double
- descricao : String
- isInducao : boolean
}

class Colecao{
- id : long
- nome : String
}

class Categoria{
- id : long
- tipo : String
}

class Cor{
- id : long
- nome : String
}

abstract Componente{
- id : long
- peso : double
}

enum Tamanho{
+ PEQUENA
+ MEDIA
+ GRANDE
+ GIGANTE
}

enum TipoSustentacao{
+ CABO
+ ALCA
}
class Fornecedor{
- id : long
- nome : String
- telefone : String
- cnpj : String
}

class Material{
- id : long
- nome : String
- qualidades[] : String
}

class Tampa{
- isDePressao : boolean
}

class Fundo{
- espessura : double
- isAntiaderente : boolean
}

class Sustentacao{
- tamanhoEmCm : int
- quantidade : int
}

Panela "*" o--> "1" Colecao
Panela "1" *--> "1" Fundo
Panela "1" *--> "1" Sustentacao
Panela "1" *--> "0..1" Tampa
Panela "*" o--> "1" Fornecedor
Panela "*" --> "1" Tamanho
Panela "*" o--> "1" Categoria
Panela "*" --> "1" Cor

Componente <|-- Tampa
Componente <|-- Fundo
Componente <|-- Sustentacao
Componente "*" o-- "*" Material

Sustentacao "*" --> "1" TipoSustentacao

@enduml