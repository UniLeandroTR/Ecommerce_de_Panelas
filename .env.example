# Configuração do Banco de Dados
DB_KIND=postgresql
DB_USERNAME=seu_usuario_bd
DB_PASSWORD=sua_senha_bd
DB_URL=jdbc:postgresql://localhost:5432/ecommerce

# JWT
JWT_PUBLIC_KEY_LOCATION=META-INF/resources/public.pem
JWT_ISSUER=Ecommerce-de-Panelas
JWT_SIGN_KEY_LOCATION=META-INF/resources/private.pem

# Redis Cache
REDIS_HOSTS=redis://localhost/

# Argon2id - parâmetros recomendados OWASP 2024
ARGON2_ITERATIONS=3
ARGON2_MEMORY=65536
ARGON2_PARALLELISM=4
ARGON2_HASH_LENGTH=32
ARGON2_SALT_LENGTH=16

# Mailer Configuration
MAILER_HOST=smtp.gmail.com
MAILER_PORT=465
MAILER_USERNAME=seu_email@gmail.com
MAILER_PASSWORD=sua_senha_app_gmail
MAILER_FROM=seu_email@gmail.com
MAILER_SSL=true
MAILER_TLS=true
